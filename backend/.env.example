SECRET_KEY=change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,cinarkombiyedekparca.com,www.cinarkombiyedekparca.com,izmirkombikarttamiri.com,www.izmirkombikarttamiri.com

# Database seçimi: sqlite veya postgres
DB_ENGINE=postgres
DB_NAME=cinarkombi_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Ayarları
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://cinarkombiyedekparca.com,https://www.cinarkombiyedekparca.com,https://izmirkombikarttamiri.com,https://www.izmirkombikarttamiri.com

# CSRF Güvenilen Originler
CSRF_TRUSTED_ORIGINS=https://cinarkombiyedekparca.com,https://www.cinarkombiyedekparca.com,https://izmirkombikarttamiri.com,https://www.izmirkombikarttamiri.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
