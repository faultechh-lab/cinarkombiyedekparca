{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=3600"
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy frontend:4173
	}
}

{$REDIRECT_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
